# Nusxa oling: cp free-api/env.example free-api/.env  — keyin key'larni yozing.
# .env git'ga tushmaydi. Key'larni hech kimga bermang.

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Baseten: Model APIs sahifasidagi endpoint va model nomi
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=
